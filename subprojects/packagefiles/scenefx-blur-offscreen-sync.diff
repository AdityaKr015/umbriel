+#include <stdbool.h>
+#include <stdint.h>
+
+#include <wlr/render/drm_syncobj.h>
 #include <wlr/types/wlr_output.h>
 #include <wlr/util/addon.h>
 
+struct fx_renderer;
+
 /**
  * Used to add effect framebuffers per output instead of every output sharing
  * them.
@@ -24,9 +30,24 @@ struct fx_offscreen_buffers {
 	struct fx_framebuffer *effects_buffer;
 	// Swap buffer used for effects
 	struct fx_framebuffer *effects_buffer_swapped;
+
+	// Cross-frame sync for persistent effects FBOs. The scanout buffer is
+	// fenced via wlr_scene_output::in_timeline; offscreen blur targets are not.
+	struct wlr_drm_syncobj_timeline *effects_timeline;
+	uint64_t effects_gpu_point;
+	bool effects_used_this_pass;
 };
 
 void fx_offscreen_buffers_destroy(struct fx_offscreen_buffers *fbos);
 struct fx_offscreen_buffers *fx_offscreen_buffers_try_get(struct wlr_output *output);
 
+// Wait for the previous frame that wrote effects_buffer(s) before reusing them.
+void fx_offscreen_buffers_wait_before_reuse(struct fx_offscreen_buffers *fbos,
+		struct fx_renderer *renderer);
+// Mark that this render pass will write the effects ping-pong buffers.
+void fx_offscreen_buffers_note_effects_used(struct fx_offscreen_buffers *fbos);
+// Record the render-pass timeline point signaled at submit for the next wait.
