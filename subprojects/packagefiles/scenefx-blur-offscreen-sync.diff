diff --git a/render/fx_renderer/fx_offscreen_buffers.c b/render/fx_renderer/fx_offscreen_buffers.c
index 8574a05..bde77b7 100644
--- a/render/fx_renderer/fx_offscreen_buffers.c
+++ b/render/fx_renderer/fx_offscreen_buffers.c
@@ -1,12 +1,93 @@
 #include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <wlr/render/drm_syncobj.h>
 #include <wlr/types/wlr_output.h>
 #include <wlr/util/addon.h>
 #include <wlr/util/log.h>
 
+#include "render/egl.h"
 #include "render/fx_renderer/fx_renderer.h"
 #include "scenefx/render/fx_renderer/fx_renderer.h"
 #include "scenefx/render/fx_renderer/fx_offscreen_buffers.h"
 
+// Default on. Set SCENEFX_BLUR_OFFSCREEN_SYNC=0 to disable for A/B testing.
+static bool fx_blur_offscreen_sync_enabled(void) {
+	static int enabled = -1;
+	if (enabled == -1) {
+		const char *env = getenv("SCENEFX_BLUR_OFFSCREEN_SYNC");
+		enabled = env == NULL || env[0] == '\0' || strcmp(env, "0") != 0;
+		if (!enabled) {
+			wlr_log(WLR_INFO,
+				"SCENEFX_BLUR_OFFSCREEN_SYNC: off (effects FBO cross-frame sync disabled)");
+		}
+	}
+	return enabled;
+}
+
+static bool fx_wait_render_timeline_point(struct fx_renderer *renderer,
+		struct wlr_drm_syncobj_timeline *timeline, uint64_t point) {
+	if (timeline == NULL || point == 0) {
+		return true;
+	}
+
+	int sync_file_fd = wlr_drm_syncobj_timeline_export_sync_file(timeline, point);
+	if (sync_file_fd < 0) {
+		wlr_log(WLR_ERROR, "Failed to export sync file for effects buffer reuse");
+		return false;
+	}
+
+	EGLSyncKHR sync = wlr_egl_create_sync(renderer->egl, sync_file_fd);
+	close(sync_file_fd);
+	if (sync == EGL_NO_SYNC_KHR) {
+		wlr_log(WLR_ERROR, "Failed to create EGL sync for effects buffer reuse");
+		return false;
+	}
+
+	bool ok = wlr_egl_wait_sync(renderer->egl, sync);
+	wlr_egl_destroy_sync(renderer->egl, sync);
+	if (!ok) {
+		wlr_log(WLR_ERROR, "eglWaitSyncKHR failed while waiting for effects buffer reuse");
+	}
+	return ok;
+}
+
+void fx_offscreen_buffers_wait_before_reuse(struct fx_offscreen_buffers *fbos,
+		struct fx_renderer *renderer) {
+	if (!fx_blur_offscreen_sync_enabled() || fbos->effects_gpu_point == 0) {
+		return;
+	}
+
+	if (!fx_wait_render_timeline_point(renderer, fbos->effects_timeline,
+			fbos->effects_gpu_point)) {
+		glFinish();
+	}
+}
+
+void fx_offscreen_buffers_note_effects_used(struct fx_offscreen_buffers *fbos) {
+	if (!fx_blur_offscreen_sync_enabled()) {
+		return;
+	}
+	fbos->effects_used_this_pass = true;
+}
+
+void fx_offscreen_buffers_record_effects_frame(struct fx_offscreen_buffers *fbos,
+		struct wlr_drm_syncobj_timeline *timeline, uint64_t point) {
+	if (!fx_blur_offscreen_sync_enabled() || !fbos->effects_used_this_pass) {
+		fbos->effects_used_this_pass = false;
+		return;
+	}
+
+	fbos->effects_used_this_pass = false;
+	if (timeline == NULL || point == 0) {
+		return;
+	}
+
+	wlr_drm_syncobj_timeline_unref(fbos->effects_timeline);
+	fbos->effects_timeline = wlr_drm_syncobj_timeline_ref(timeline);
+	fbos->effects_gpu_point = point;
+}
+
 static void addon_handle_destroy(struct wlr_addon *addon) {
 	struct fx_offscreen_buffers *fbos = wl_container_of(addon, fbos, addon);
 
@@ -32,6 +113,8 @@ static void addon_handle_destroy(struct wlr_addon *addon) {
 		fbos->effects_buffer_swapped = NULL;
 	}
 
+	wlr_drm_syncobj_timeline_unref(fbos->effects_timeline);
+
 	wl_list_remove(&fbos->link);
 	wlr_addon_finish(&fbos->addon);
 	free(fbos);
