 	scene_node_update(&shadow->node, NULL);
 }
 
+void wlr_scene_shadow_set_output_clip(struct wlr_scene_shadow *shadow,
+		const struct wlr_box *output_clip) {
+	if (output_clip == NULL) {
+		if (!shadow->has_output_clip) {
+			return;
+		}
+		shadow->has_output_clip = false;
+	} else {
+		if (shadow->has_output_clip &&
+				wlr_box_equal(&shadow->output_clip, output_clip)) {
+			return;
+		}
+		shadow->has_output_clip = true;
+		shadow->output_clip = *output_clip;
+	}
+	scene_node_update(&shadow->node, NULL);
+}
